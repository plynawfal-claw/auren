# Canonical origin. Everything — canonical tags, OG URLs, sitemap, JSON-LD @id
# — is built from this. Set it deliberately in production; getting it wrong
# splits the entity across two hostnames.
NEXT_PUBLIC_SITE_URL=https://aurren.app

# Contact channels. Leave blank and every CTA falls back to the brief form
# rather than rendering a dead link.
NEXT_PUBLIC_CONTACT_EMAIL=
# Digits only, international format, no + or spaces. e.g. 212600000000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Where project briefs are forwarded: n8n, Make, HubSpot, GoHighLevel,
# Supabase — anything that accepts a JSON POST. Brief submission returns an
# error until this is configured; server logs are not a durable inbox.
BRIEF_WEBHOOK_URL=
# Optional. Sent as `Authorization: Bearer <token>`.
BRIEF_WEBHOOK_TOKEN=

# Analytics. Each is optional; nothing loads unless the id is present.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
