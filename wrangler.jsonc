{
  // AUREN on Cloudflare Workers (free plan), built by @opennextjs/cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auren",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // No workers.dev address: the account has none registered and the site does
  // not need one. It is reached only through its own domain.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // Temporary: preview before the apex is attached. Removed after go-live.
    { "pattern": "preview.aurren.app", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "vars": {
    // Canonical origin: every canonical, sitemap URL and JSON-LD @id derives
    // from this. Must be set at build time too (see package.json scripts).
    "NEXT_PUBLIC_SITE_URL": "https://aurren.app"
  }
}
